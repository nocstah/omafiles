[Unit]
# Warms Omafiles at login so launches from other apps are instant.
#
# Without this, `omafiles <path>` from xdg-open / "Show in file manager" /
# a .desktop launch costs a full cold start (~1.2s on this machine: fontconfig
# init, the QML engine, and the startup mount scan) whenever no window happens
# to be open. With it, the first instance is already running and every later
# launch is delivered over the single-instance socket instead -- measured
# ~0.09s, an order of magnitude quicker.
#
# --preload keeps the window hidden until something actually asks for it, so
# the warm instance costs a process, not a window on your desktop.
#
# Install:
#   cp packaging/omafiles-preload.service ~/.config/systemd/user/
#   systemctl --user enable --now omafiles-preload.service
#
# NOTE: this does not speed up the xdg-desktop-portal FileChooser (Save/Open
# dialogs). Those deliberately bypass the single instance -- see the isPicker
# guard in main.cpp -- because the portal helper treats the launched process
# exiting as "dialog cancelled", so a forwarding stub that exits immediately
# would cancel the request.
Description=Omafiles preloaded file manager instance
Documentation=https://github.com/Percius04/omafiles
PartOf=graphical-session.target
After=graphical-session.target
# A warm cache must not be rate-limited out of existence by a few restarts.
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=%h/.local/bin/omafiles --preload
# always, not on-failure: closing the window is a CLEAN exit, and on-failure
# would leave nothing warm for the next launch. The window normally hides
# rather than quits (see app/Main.qml onClosing), so this is the backstop for
# a real crash or an explicit kill.
Restart=always
RestartSec=2

[Install]
WantedBy=graphical-session.target
